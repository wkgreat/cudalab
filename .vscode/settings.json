{
  // This file deliberately contains no machine-specific paths. Everything tied
  // to this machine - the CUDA toolkit, the MSVC toolchain, the Windows SDK,
  // CMake and the GPU's compute capability - lives in env.json at the
  // repository root and is consumed by the scripts and by CMakeLists.txt.
  // Refreshing that one file (scripts/sync-env.ps1) is all a new machine needs.

  // ---------------------------------------------------------------------------
  // CUDA C++ support
  // ---------------------------------------------------------------------------
  // Route CUDA sources through the "cuda-cpp" language mode: that is the mode
  // in which the C/C++ extension understands __global__, __device__ and the
  // <<<...>>> launch syntax. (clangd reads .cu files as CUDA via the generated
  // compile database, so this only matters if you switch IntelliSense back.)
  "files.associations": {
    "*.cu": "cuda-cpp",
    "*.cuh": "cuda-cpp"
  },

  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",

  // ---------------------------------------------------------------------------
  // Build integration
  // ---------------------------------------------------------------------------
  // CMake is the only build system, driven by the tasks in tasks.json, which
  // call scripts/build-cmake.ps1. That script imports the MSVC environment
  // first, because the Ninja generator needs cl.exe on PATH (nvcc uses MSVC as
  // its host compiler), and it finds CMake itself: PATH first, then env.json,
  // then the copy bundled with Visual Studio. Automatic configure is off for
  // the same reason - the extension would run cmake without that environment.
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "cmake.configureOnEdit": false,

  // ---------------------------------------------------------------------------
  // Keep editors and search out of the build tree
  // ---------------------------------------------------------------------------
  "files.watcherExclude": {
    "**/build/**": true
  },
  "search.exclude": {
    "**/build/**": true
  },
  "C_Cpp.files.exclude": {
    "**/build/**": true
  },

  // ---------------------------------------------------------------------------
  // IntelliSense: clangd
  // ---------------------------------------------------------------------------
  // clangd is the IntelliSense engine. It reads compile_commands.json from the
  // repository root, which scripts/build-cmake.ps1 regenerates before every
  // build (and scripts/sync-env.ps1 on demand). That database is rendered in
  // clang's own dialect for every source *and* every header, with the CUDA and
  // Windows SDK paths taken from env.json - which is why there is no .clangd
  // file to keep in sync any more.
  "clangd.enable": true,

  // The C/C++ extension would otherwise feed a second, disagreeing set of
  // diagnostics for the same files. It stays installed for its debugger
  // (cppvsdbg), which is what launch.json uses.
  "C_Cpp.intelliSenseEngine": "disabled"
}

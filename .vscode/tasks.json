{
  // Build tasks for the CUDA lab.
  //
  // CMake is the only build system: every task below runs a script from
  // scripts/ through pixi, so the pinned toolchain (CMake, Ninja, CUDA, cl.exe)
  // is active.
  //
  //   Ctrl+Shift+B            -> "CMake: build all demos (ninja-debug)"
  //   Ctrl+Shift+P > Run Task -> pick any task below
  "version": "2.0.0",
  "tasks": [
    {
      "label": "env: refresh clangd database",
      "detail": "Regenerate compile_commands.json from the build tree",
      "type": "shell",
      "command": "pixi",
      "args": [
        "run",
        "--",
        "python",
        "${workspaceFolder}/scripts/sync_env.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: build all demos (ninja-debug)",
      "detail": "Configure + build every demo target under src/demos",
      "type": "shell",
      "command": "pixi",
      "args": [
        "run",
        "--",
        "python",
        "${workspaceFolder}/scripts/build_cmake.py",
        "--preset",
        "ninja-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: build all demos (ninja-release)",
      "type": "shell",
      "command": "pixi",
      "args": [
        "run",
        "--",
        "python",
        "${workspaceFolder}/scripts/build_cmake.py",
        "--preset",
        "ninja-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: build one demo (ninja-debug)",
      "detail": "Build a single demo target; prompts for the demo directory name",
      "type": "shell",
      "command": "pixi",
      "args": [
        "run",
        "--",
        "python",
        "${workspaceFolder}/scripts/build_cmake.py",
        "--preset",
        "ninja-debug",
        "--demo",
        "${input:demo}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: clean rebuild all demos (ninja-debug)",
      "detail": "Wipe the configure cache and rebuild everything",
      "type": "shell",
      "command": "pixi",
      "args": [
        "run",
        "--",
        "python",
        "${workspaceFolder}/scripts/build_cmake.py",
        "--preset",
        "ninja-debug",
        "--clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: build + run all demos (ninja-debug)",
      "detail": "Compile everything, then run each demo and check its exit code",
      "type": "shell",
      "command": "pixi",
      "args": [
        "run",
        "--",
        "python",
        "${workspaceFolder}/scripts/build_cmake.py",
        "--preset",
        "ninja-debug",
        "--run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: run all demos (ninja-debug)",
      "detail": "Run the demo executables that are already built",
      "type": "shell",
      "command": "pixi",
      "args": [
        "run",
        "--",
        "python",
        "${workspaceFolder}/scripts/run_demos.py",
        "--preset",
        "ninja-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CUDA: profile a demo (Nsight Compute)",
      "detail": "Per-kernel metrics. Needs administrator rights or GPU counter permission - see README.",
      "type": "shell",
      "command": "pixi",
      "args": [
        "run",
        "--",
        "python",
        "${workspaceFolder}/scripts/profile.py",
        "--tool",
        "compute",
        "--set",
        "detailed",
        "--demo",
        "${input:demo}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CUDA: profile a demo (Nsight Systems)",
      "detail": "Timeline trace of the process, including kernel and memcpy activity",
      "type": "shell",
      "command": "pixi",
      "args": [
        "run",
        "--",
        "python",
        "${workspaceFolder}/scripts/profile.py",
        "--tool",
        "systems",
        "--demo",
        "${input:demo}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CUDA: show device (nvidia-smi)",
      "type": "shell",
      "command": "nvidia-smi",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "demo",
      "type": "promptString",
      "description": "Demo directory name under src/demos",
      "default": "demo_add_one"
    }
  ]
}

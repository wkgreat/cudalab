{
  // This file deliberately contains no machine-specific paths. The CUDA toolkit
  // root and the GPU's compute capability live in env.json at the repository
  // root, which CMakeLists.txt reads directly.

  // ---------------------------------------------------------------------------
  // CUDA C++ support
  // ---------------------------------------------------------------------------
  // Route CUDA sources through the "cuda-cpp" language mode so the editor knows
  // __global__, __device__ and the <<<...>>> launch syntax.
  "files.associations": {
    "*.cu": "cuda-cpp",
    "*.cuh": "cuda-cpp"
  },

  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",

  // ---------------------------------------------------------------------------
  // Build integration
  // ---------------------------------------------------------------------------
  // CMake is the only build system, driven either by the tasks in tasks.json or
  // by the CMake Tools extension, both using the Ninja presets from
  // CMakePresets.json. Configure-on-open is safe here: on Linux nvcc uses g++
  // as its host compiler and CMakeLists.txt locates nvcc through env.json, so
  // no special environment has to be prepared first.
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.configureOnEdit": false,

  // ---------------------------------------------------------------------------
  // Keep editors and search out of the build tree
  // ---------------------------------------------------------------------------
  "files.watcherExclude": {
    "**/build/**": true
  },
  "search.exclude": {
    "**/build/**": true
  },
  "C_Cpp.files.exclude": {
    "**/build/**": true
  },

  // ---------------------------------------------------------------------------
  // IntelliSense: clangd
  // ---------------------------------------------------------------------------
  // clangd is the IntelliSense engine. CMake writes compile_commands.json into
  // the preset's build directory (CMAKE_EXPORT_COMPILE_COMMANDS is ON), so point
  // clangd at it. The .cpp/.h entries are plain g++ command lines that clangd
  // consumes directly.
  "clangd.enable": true,
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/ninja-debug",
    "--query-driver=/usr/bin/g++,/usr/bin/gcc,/usr/local/cuda/bin/nvcc"
  ],

  // The C/C++ extension would otherwise feed a second, disagreeing set of
  // diagnostics for the same files. It stays installed for its cppdbg debugger,
  // which is what launch.json uses.
  "C_Cpp.intelliSenseEngine": "disabled"
}
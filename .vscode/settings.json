{
  // This file deliberately contains no machine-specific paths. Everything tied
  // to this machine - CUDA, CMake and the toolchain versions - comes from pixi
  // (pixi.toml), and the MSVC toolchain, the Windows SDK and the GPU's compute
  // capability are detected at run time by the scripts. A new machine needs no
  // config file: "pixi install" and a build are enough.

  // ---------------------------------------------------------------------------
  // CUDA C++ support
  // ---------------------------------------------------------------------------
  // Route CUDA sources through the "cuda-cpp" language mode: that is the mode
  // in which the C/C++ extension understands __global__, __device__ and the
  // <<<...>>> launch syntax. (clangd reads .cu files as CUDA via the generated
  // compile database, so this only matters if you switch IntelliSense back.)
  "files.associations": {
    "*.cu": "cuda-cpp",
    "*.cuh": "cuda-cpp"
  },

  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",

  // ---------------------------------------------------------------------------
  // Build integration
  // ---------------------------------------------------------------------------
  // CMake is the only build system, driven by the tasks in tasks.json, which
  // run scripts/build_cmake.py inside pixi. That script relies on the pixi
  // environment for cl.exe (the Ninja generator needs it on PATH and nvcc uses
  // MSVC as its host compiler) and for CMake itself. Automatic configure is off
  // for the same reason - the extension would run cmake without that environment.
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "cmake.configureOnEdit": false,

  // ---------------------------------------------------------------------------
  // Keep editors and search out of the build tree
  // ---------------------------------------------------------------------------
  "files.watcherExclude": {
    "**/build/**": true
  },
  "search.exclude": {
    "**/build/**": true
  },
  "C_Cpp.files.exclude": {
    "**/build/**": true
  },

  // ---------------------------------------------------------------------------
  // IntelliSense: clangd
  // ---------------------------------------------------------------------------
  // clangd is the IntelliSense engine. It reads compile_commands.json from the
  // repository root, which scripts/build_cmake.py regenerates before every
  // build (and scripts/sync_env.py on demand). That database is rendered in
  // clang's own dialect for every source *and* every header, with the CUDA and
  // Windows SDK paths detected at run time - which is why there is no .clangd
  // file to keep in sync any more.
  "clangd.enable": true,

  // The C/C++ extension would otherwise feed a second, disagreeing set of
  // diagnostics for the same files. It stays installed for its debugger
  // (cppvsdbg), which is what launch.json uses.
  "C_Cpp.intelliSenseEngine": "disabled"
}
